# Digicardo Frontend Environment Configuration

# Public Application URL (Used for metadata, absolute links, and canonical URLs)
# Production: https://digicardo.in
NEXT_PUBLIC_APP_URL=https://digicardo.in

# Backend Laravel API URL (Used when frontend and backend run on separate servers)
# Production: https://api.digicardo.in
NEXT_PUBLIC_API_URL=https://api.digicardo.in

# Same-Origin BFF API Base Path (Accessed by browser components)
NEXT_PUBLIC_API_BASE_URL=/api/bff/v1

# Internal Laravel API URL (Used by Next.js Server Components and BFF Route Handlers)
# In production, this can also point to your backend origin (e.g., https://api.digicardo.in)
LARAVEL_INTERNAL_API_URL=https://api.digicardo.in

# Secret token for on-demand edge cache revalidation (Must match Laravel NEXT_REVALIDATE_SECRET)
NEXT_REVALIDATE_SECRET=your-secret-token-here

# Optional: Cloudflare Analytics / Telemetry Token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
